APP_ENV=local
APP_URL=http://localhost/MusicAdminAPI/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=music_app_v2
DB_USER=root
DB_PASS=

ADMIN_USERNAME=admin
# Prefer a password hash. Generate with: php -r "echo password_hash('YOUR_PASSWORD', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=
# Backward-compatible fallback only. Remove after setting ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

CORS_ORIGIN=http://localhost
TOKEN_TTL=86400
